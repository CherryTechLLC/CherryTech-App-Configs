#VAULTWARDEN - 6001

accounts.{env.DOMAIN} {

  tls {
    dns hetzner {env.HETZNER_API_TOKEN}
    propagation_delay 30s
    resolvers 1.1.1.1
  }


  encode zstd gzip

  reverse_proxy 127.0.0.1:6001 {
    header_up X-Real-IP {remote_host}
  }

  header {
    Strict-Transport-Security "max-age=31536000;"
    X-Content-Type-Options "nosniff"
  }
}
