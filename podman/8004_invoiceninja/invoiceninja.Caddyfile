#INVOICE-NINJA - 8004

invoice.{env.DOMAIN} {

  tls {
    dns hetzner {env.HETZNER_API_TOKEN}
    propagation_delay 30s
    resolvers 1.1.1.1
  }

  encode zstd gzip

  reverse_proxy 127.0.0.1:8004 {
    header_up X-Real-IP {remote_host}
    header_up X-Forewarded-For {remote_host}
    header_up Host {host}
  }

}
