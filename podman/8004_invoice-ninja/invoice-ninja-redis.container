#invoice-ninja-redis.container

[Container]
Image=docker.io/valkey/valkey:9
ContainerName=invoice-ninja-redis
Pod=invoice-ninja.pod
Volume=/home/invoice-ninja/.data/invoice-ninja/invoiceninja-valkey:/data:Z
EnvironmentFile=/srv/CherryTech-App-Configs/podman/8004_invoice-ninja/.env
HealthCmd=valkey-cli ping
HealthStartPeriod=30s
HealthInterval=120s
HealthTimeout=15s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=2g
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
