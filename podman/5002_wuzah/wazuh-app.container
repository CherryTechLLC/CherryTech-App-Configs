#wazuh-manager.container

[Unit]
Description=Wazuh App
Requires=wazuh-redis.service wazuh-db.service
After=wazuh-redis.service wazuh-db.service

[Container]
Image=docker.io/wazuh/wazuh-manager:5.1.0
ContainerName=wazuh-app
Pod=wazuh.pod
EnvironmentFile=/home/wazuh/.data/wazuh/.env
Secret=wazuh-db-password,type=env,target=DB_PASSWORD
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/wazuh/.data/wazuh/wazuh-app:/data:Z
Volume=/home/wazuh/.data/wazuh/wazuh-app:/var/www/html:Z
Volume=/home/wazuh/.data/wazuh/wazuh-public:/var/www/html/public:Z
Volume=/home/wazuh/.data/wazuh/wazuh-storage:/var/www/html/storage:Z
HealthCmd=
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
