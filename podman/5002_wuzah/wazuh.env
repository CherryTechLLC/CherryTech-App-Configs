#Wazuh .env

#SETUP
DOMAIN=wazuh.apps.domain.tld
wazuh_TRUSTED_PROXIES=127.0.0.1/32
TZ=America/Detroit

#DB-CONFIG
POSTGRES_DB=wazuh
POSTGRES_USER=wazuh
POSTGRES_INITDB_ARGS=--data-checksum

#DB-CONFIG
MARIADB_DATABASE=wazuh
MARIADB_USER=wazuh

#APP-DB-CONNECTION
DB_USERNAME=wazuh
DB_PORT=5432 (3306 for Mariadb)
DB_HOSTNAME=wazuh-db
DB_DATABASE_NAME=wazuh

#APP-REDIS-CONNECTION
REDIS_PORT=6379
REDIS_HOSTNAME=wazuh-redis

#APP-CONFIG
