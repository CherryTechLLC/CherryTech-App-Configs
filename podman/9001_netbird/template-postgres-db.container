#EXAMPLE-db.container

[Unit]
Description=EXAMPLE Database

[Container]
Image=docker.io/library/postgres:17.10@sha256:0027bef26712baaee437a4ea48fdf3d2d2e2bc5f0d81615374408ca320f3c7e3
ContainerName=EXAMPLE-db
Pod=EXAMPLE.pod
Volume=/home/EXAMPLE/.data/EXAMPLE/EXAMPLE-db-backups:/var/db-backups/:Z
Volume=/home/EXAMPLE/.data/EXAMPLE/EXAMPLE-db:/var/lib/postgresql/data:Z
EnvironmentFile=/srv/CherryTech-App-Configs/podman/0000_EXAMPLE/.env
Secret=EXAMPLE-db-password,type=env,target=POSTGRES_PASSWORD
HealthCmd=pg_isready -q -d EXAMPLE -U EXAMPLE
HealthStartPeriod=5m
HealthInterval=60s
HealthTimeout=15s
HealthRetries=10
Notify=healthy
Memory=2g
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
