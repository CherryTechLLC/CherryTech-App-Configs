#netbird-dashboard.container

[Unit]
Description=Netbird Dashboard
Requires=netbird-db.service
After=netbird-db.service

[Container]
Image=docker.io/netbirdio/dashboard:latest
ContainerName=netbird-dashboard
Network=netbird.network
EnvironmentFile=/home/netbird/.data/netbird/.env
Secret=netbird-client-secret,type=env,target=AUTH_CLIENT_SECRET
#HealthCmd=
#HealthStartPeriod=3m
#HealthInterval=120s
#HealthTimeout=30s
#HealthRetries=10
#Notify=healthy
AutoUpdate=registry
Memory=3g
LogDriver=json-file
LogOpt=max-size=500m
UserNS=keep-id
PublishPort=127.0.0.1:9001:80
#NoNewPrivileges=true
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
