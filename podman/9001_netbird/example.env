#EXAMPLE .env

DOMAIN=EXAMPLE.apps.example.com

EXAMPLE_TRUSTED_PROXIES=127.0.0.1/32
TZ=America/Detroit

POSTGRES_DB=EXAMPLE
POSTGRES_USER=EXAMPLE
POSTGRES_INITDB_ARGS=--data-checksum

MARIADB_DATABASE=EXAMPLE
MARIADB_USER=EXAMPLE

DB_USERNAME=EXAMPLE
DB_PORT=5432 (3306 for Mariadb)
DB_HOSTNAME=EXAMPLE-db
DB_DATABASE_NAME=EXAMPLE

REDIS_PORT=6379
REDIS_HOSTNAME=EXAMPLE-redis

NETBIRD_MGMT_API_ENDPOINT=$NETBIRD_HTTP_PROTOCOL://$NETBIRD_DOMAIN
NETBIRD_MGMT_GRPC_API_ENDPOINT=$NETBIRD_HTTP_PROTOCOL://$NETBIRD_DOMAIN
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY=$NETBIRD_HTTP_PROTOCOL://$NETBIRD_DOMAIN/oauth2
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email offline_access
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none

NB_LOG_LEVEL=info
NB_LISTEN_ADDRESS=:80
NB_EXPOSED_ADDRESS=$NETBIRD_RELAY_PROTO://$NETBIRD_DOMAIN:$NETBIRD_PORT
NB_AUTH_SECRET=$NETBIRD_RELAY_AUTH_SECRET
