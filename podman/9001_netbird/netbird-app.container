#netbird-app.container

[Unit]
Description=Netbird App
Requires=netbird-redis.service netbird-db.service
After=netbird-redis.service netbird-db.service

[Container]
Image=docker.io/netbird-app/netbird-server:0.0.0
ContainerName=netbird-app
Pod=netbird.pod
EnvironmentFile=/srv/CherryTech-App-Configs/podman/9001_netbird/.env
Secret=netbird-db-password,type=env,target=DB_PASSWORD
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/netbird/.data/netbird/netbird-app:/data:Z
Volume=/home/netbird/.data/netbird/netbird-app:/var/www/html:Z
Volume=/home/netbird/.data/netbird/netbird-public:/var/www/html/public:Z
Volume=/home/netbird/.data/netbird/netbird-storage:/var/www/html/storage:Z
HealthCmd=
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
