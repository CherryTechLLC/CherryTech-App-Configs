#netbird.Caddyfile
#NETBIRD FULL Caddyfile

{

#  acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

  #Must disable Caddy API on a multi-user system as it is locally accesable to ALL users

  admin off

  email letsencrypt.acme@app.garagedoorservicesinc.com

}

overlay.domain.tld {

  encode zstd gzip

  @grpc header Content-Type application/grpc*
  reverse_proxy @grpc h2c://127.0.0.1:8081

  @backend path /relay* /ws-proxy* /api* /oauth2/*
  reverse_proxy @backend 127.0.0.1:8081

  #Dashboard
  reverse_proxy 127.0.0.1:9001
}

