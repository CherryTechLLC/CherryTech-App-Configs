# NetBird Combined Server Configuration
# Copy this file to config.yaml and customize for your deployment
#
# This is a Management server with optional embedded Signal, Relay, and STUN services.
# By default, all services run locally. You can use external services instead by
# setting the corresponding override fields.
#
# Architecture:
#   - Management: Always runs locally (this IS the management server)
#   - Signal: Local by default; set 'signalUri' to use external (disables local)
#   - Relay: Local by default; set 'relays' to use external (disables local)
#   - STUN: Local on port 3478 by default; set 'stuns' to use external instead

server:
  listenAddress: ":80"

  exposedAddress: "https://overlay.domain.tld:443"

  metricsPort: 9090

  healthcheckAddress: ":9000"

  logLevel: "info"    # Default log level for all components: panic, fatal, error, warn, info, debug, trace
  logFile: "console"  # "console" or path to log file






  dataDir: "/var/lib/netbird/"

  # ============================================================================
  # Management Settings
  # ============================================================================

  disableAnonymousMetrics: false
  disableGeoliteUpdate: false






  # Embedded authentication/identity provider (Dex) configuration (always enabled)
  auth:
    # OIDC issuer URL - must be publicly accessible
    issuer: "https://overlay.domain.tld/oauth2"
    localAuthDisabled: false
    signKeyRefreshEnabled: false
    # MFA session settings (applies when TOTP is enabled for an account)
    # mfaSessionMaxLifetime: "24h"  # Max duration for an MFA session from creation
    # mfaSessionIdleTimeout: "1h"   # MFA session expires after this idle period
    # mfaSessionRememberMe: false   # Pre-check "remember me" on login so the MFA session persists across tabs/restarts
    # Optional AES key for encrypting embedded IdP session cookies. Can also be set via NB_IDP_SESSION_COOKIE_ENCRYPTION_KEY.
    # Must be 16/24/32 raw bytes or base64-encoded to one of those lengths (for example: openssl rand -hex 16).
    # sessionCookieEncryptionKey: ""
    # OAuth2 redirect URIs for dashboard
    dashboardRedirectURIs:
      - "https://overlay.domain.tld/nb-auth"
      - "https://overlay.domain.tld/nb-silent-auth"
    # OAuth2 redirect URIs for CLI
    cliRedirectURIs:
      - "http://localhost:53000/"
    # OAuth2 post-logout redirect URIs for dashboard (RP-initiated logout)
    # dashboardPostLogoutRedirectURIs:
    #   - "https://app.example.com/"
    # Optional initial admin user
    # owner:
    #   email: "admin@example.com"
    #   password: "initial-password"



  # Database configuration
  store:
    engine: "postgres"  # sqlite or postgres
    # dsn: ""  # Connection string for postgres (EXPOSED AS A SECRET)
    # encryptionKey: ""
    # file: ""  # Custom SQLite file path (optional, defaults to {dataDir}/store.db)



  # Activity events store configuration (optional, defaults to sqlite in dataDir)
  # activityStore:
  #   engine: "sqlite"  # sqlite or postgres
  #   dsn: ""  # Connection string for postgres
  #   file: ""  # Custom SQLite file path (optional, defaults to {dataDir}/events.db)

  # Reverse proxy access log store configuration (optional, follows the store engine:
  # sqlite uses its own file in dataDir, postgres reuses the store DSN with a separate pool)
  # accessLogStore:
  #   engine: "postgres"  # sqlite or postgres
  #   dsn: ""  # Connection string for a dedicated postgres database
  #   file: ""  # Custom SQLite file path (optional, defaults to {dataDir}/access_logs.db)

  # Auth (embedded IdP) store configuration (optional, defaults to sqlite3 in dataDir/idp.db)
  # authStore:
  #   engine: "sqlite3"  # sqlite3 or postgres
  #   dsn: ""  # Connection string for postgres (e.g., "host=localhost port=5432 user=postgres password=postgres dbname=netbird_idp sslmode=disable")
  #   file: ""  # Custom SQLite file path (optional, defaults to {dataDir}/idp.db)

  # Reverse proxy settings (optional)
  reverseProxy:
     trustedHTTPProxies: [127.0.0.1/32]           # CIDRs of trusted reverse proxies (e.g. ["10.0.0.0/8"])
     trustedHTTPProxiesCount: 1       # Number of trusted proxies in front of the server (alternative to trustedHTTPProxies)
  #   trustedPeers: []                 # CIDRs of trusted peer networks (e.g. ["100.64.0.0/10"])
     accessLogRetentionDays: 7        # Days to retain HTTP access logs. 0 (or unset) defaults to 7. Negative values disable cleanup (logs kept indefinitely).
     accessLogCleanupIntervalHours: 24 # How often (in hours) to run the access-log cleanup job. 0 (or unset) is treated as "not set" and defaults to 24 hours; cleanup remains enabled. To disable cleanup, set accessLogRetentionDays to a negative value.


