#nextcloud-db.container

[Unit]
Description=Nextcloud Database

[Container]
Image=docker.io/library/postgres:17.10@sha256:0027bef26712baaee437a4ea48fdf3d2d2e2bc5f0d81615374408ca320f3c7e3
ContainerName=nextcloud-db
Pod=nextcloud.pod
Volume=/home/nextcloud/.data/nextcloud/nextcloud-db-backups:/var/db-backups/:Z
Volume=/home/nextcloud/.data/nextcloud/nextcloud-db:/var/lib/postgresql/data:Z
EnvironmentFile=/srv/CherryTech-App-Configs/podman/8002_nextcloud/.env
Secret=nextcloud-db-password,type=env,target=POSTGRES_PASSWORD
HealthCmd=/usr/bin/pg_isready -q -d nextcloud -U nextcloud
HealthStartPeriod=5m
HealthInterval=60s
HealthTimeout=15s
HealthRetries=10
Notify=healthy
Memory=2g
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
