#Authentik .env

AUTHENTIK_HOST=sso.example.com

AUTHENTIK_EMAIL__HOST=mail.your-server.de
AUTHENTIK_EMAIL__PORT=465
AUTHENTIK_EMAIL__USERNAME=sso
#AUTHENTIK_EMAIL__USE_TLS=true
#AUTHENTIK_EMAIL__USE_SSL=true
AUTHENTIK_EMAIL__TIMEOUT=60
AUTHENTIK_EMAIL__FROM=sso@example.com

AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=127.0.0.1/32
TZ=America/Detroit

POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_INITDB_ARGS=--data-checksum

AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__HOST=authentik-db
AUTHENTIK_POSTGRESQL__NAME=authentik
