#AUTHENTIK - 6002

sso.{env.DOMAIN} {

  tls {
    dns hetzner {env.HETZNER_API_TOKEN}
    propagation_delay 30s
    resolvers 1.1.1.1
  }

  encode zstd gzip

  reverse_proxy http://127.0.0.1:6002

  header {
    Strict-Transport-Security "max-age=31536000;"
    X-Content-Type-Options "nosniff"
  }
}

