#netbird-crowdsec.container

[Unit]
Description=Netbird Crowdsec

[Container]
Image=docker.io/crowdsecurity/crowdsec:latest
ContainerName=netbird-crowdsec
Network=netbird.network
EnvironmentFile=/home/netbird/.data/netbird/.env
Secret=netbird-db-password,type=env,target=DB_PASSWORD
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/netbird/.data/netbird/netbird-crowdsec:/var/lib/crowdsec/data:Z

HealthCmd=
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
UserNS=keep-id
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
