#opsi-garafana.container

[Unit]
Description=Opsi Grafana

[Container]
Image=docker.io/grafana/grafana:latest
ContainerName=opsi-grafana
Pod=opsi.pod
EnvironmentFile=/home/opsi/.data/opsi/.env
Secret=opsi-grafana-password,type=env,target=GF_SECURITY_ADMIN_PASSWORD
Volume=/home/opsi/.data/opsi/opsi-grafana-data:/var/lib/grafana:Z
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/api/health
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
#Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
