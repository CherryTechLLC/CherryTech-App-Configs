#opsi-db.container

[Unit]
Description=Opsi Database

[Container]
Image=docker.io/library/mariadb:10.11@sha256:d769e37960821dfdcf096954f6e7ac89f747e116c1bba98e48edd265dfc7deae
ContainerName=opsi-db
Pod=opsi.pod
Volume=/home/opsi/.data/opsi/opsi-db:/var/lib/mysql:Z
Volume=/home/opsi/.data/opsi/opsi-db-backups:/var/db-backups:Z
EnvironmentFile=/home/opsi/.data/opsi/.env
Secret=opsi-db-password,type=env,target=MYSQL_PASSWORD
Secret=opsi-db-root-password,type=env,target=MYSQL_ROOT_PASSWORD
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthStartPeriod=60s
HealthInterval=60s
HealthTimeout=10s
HealthRetries=15
Notify=healthy
Memory=2g
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
