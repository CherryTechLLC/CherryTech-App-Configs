#opsi-db.container

[Unit]
Description=Opsi Database

[Container]
Image=docker.io/library/mariadb:10.7@sha256:9a48ac9f196f3d4fd6fea2cab59a49df9e7ca459bf14b2f7b85a0e38a5454571
ContainerName=opsi-db
Pod=opsi.pod
Volume=/home/opsi/.data/opsi/opsi-db:/var/lib/mysql:Z
Volume=/home/opsi.data/opsi/opsi-db-backups:/var/db-backups:Z
EnvironmentFile=/home/opsi/.data/opsi/.env
Secret=opsi-db-password,type=env,target=MARIADB_PASSWORD
Secret=opsi-db-root-password,type=env,target=MARIADB_ROOT_PASSWORD
HealthCmd=/bin/bash -c 'healthcheck.sh --connect --innodb_initialized'
HealthStartPeriod=60s
HealthInterval=60s
HealthTimeout=10s
HealthRetries=15
Notify=healthy
Memory=2g
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
