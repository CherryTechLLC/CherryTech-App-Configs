#opsi-app.container

[Unit]
Description=Opsi App
Requires=opsi-redis.service opsi-db.service
After=opsi-redis.service opsi-db.service

[Container]
Image=docker.io/uibmz/opsi-server:4.3
ContainerName=opsi-app
Pod=opsi.pod
EnvironmentFile=/home/opsi/.data/opsi/.env
Secret=opsi-db-password,type=env,target=MYSQL_PASSWORD
Secret=opsi-admin-password,type=env,target=OPSI_ADMIN_PASSWORD
Secret=opsi-root-password,type=env,target=OPSI_ROOT_PASSWORD
Secret=opsi-grafana-password,type=env,target=GF_SECURITY_ADMIN_PASSWORD
Volume=/home/opsi/.data/opsi/opsi-app:/data:Z
HealthCmd=opsiconfd health-check
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
#Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
