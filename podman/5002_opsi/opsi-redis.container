#opsi-redis.container

[Unit]
Description=Opsi Redis

[Container]
Image=docker.io/redis:8.10@sha256:1f88291b4c57bdf249f02eb085a8669889b2d2954e91d4de5118a5da6b78dd53
ContainerName=opsi-redis
Network=opsi.network
Volume=/home/opsi/.data/opsi/opsi-redis:/data:Z
EnvironmentFile=/home/opsi/.data/opsi/.env
HealthCmd=/bin/sh -c 'redis-cli ping | grep PONG'
HealthStartPeriod=30s
HealthInterval=120s
HealthTimeout=15s
HealthRetries=10
Notify=healthy
Memory=1g
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
