#Opsi .env

#SETUP
OPSI_HOSTNAME=deploy.apps.domain.tld
DOMAINNAME=deploy.apps.domain.tld
TZ=America/Detroit

#DB-CONFIG
MARIADB_DATABASE=opsi
MARIADB_USER=opsi
MYSQL_INITDB_SKIP_TZINFO=1
MYSQL_MAX_CONNECTIONS=1000
MYSQL_MAX_ALLOWED_PACKET=256M
MYSQL_SORT_BUFFER_SIZE=4M

#APP-DB-CONNECTION
MYSQL_USER=opsi
MYSQL_DATABASE=opsi
MYSQL_HOST=opsi-db
MYSQL_PORT=3306

#APP-REDIS-CONNECTION
REDIS_PORT=6379
REDIS_HOSTNAME=opsi-redis

#APP-CONFIG
REDIS_HOST=opsi-redis
GRAFANA_HOST=opsi-grafana

OPSI_HOST_ROLE=configserver
OPSI_TFTPBOOT=false

OPSICONFD_PORT=4447
OPSICONFD_PORT_UDP=69

OPSICONFD_GRAFANA_EXTERNAL_URL=/grafana
OPSICONFD_LOG_LEVEL=6
OPSICONFD_LOG_LEVEL_FILE=4

#GRAFANA-CONFIG
GF_INSTALL_PLUGINS=simpod-json-datasource
GF_SERVER_ROOT_URL="%(protocol)s://%(domain)s:%(http_port)s/grafana"

#OTHER
OPSICONFD_RESTORE_BACKUP_URL=
# ^ Restore from a backup of opsi on startup (Leave Empty)
