#Opsi .env

#SETUP
HOSTNAME=deploy
DOMAINNAME=domain.tld
TZ=America/Detroit

#DB-CONFIG
MYSQL_INITDB_SKIP_TZINFO=1
MYSQL_MAX_CONNECTIONS=1000
MYSQL_MAX_ALLOWED_PACKET=256M
MYSQL_SORT_BUFFER_SIZE=4M

#APP-DB-CONNECTION
MYSQL_USER=opsi
MYSQL_DATABASE=opsi
MYSQL_HOST=opsi-db
MYSQL_PORT=3306

#APP-REDIS-CONNECTION
REDIS_PORT=6379
REDIS_HOST=opsi-redis

#APP-CONFIG
REDIS_HOST=opsi-redis
GRAFANA_HOST=opsi-grafana

OPSI_HOST_ROLE=configserver
OPSI_TFTPBOOT=false

OPSICONFD_PORT=4447

OPSICONFD_GRAFANA_EXTERNAL_URL=/grafana
OPSICONFD_LOG_LEVEL=6
OPSICONFD_LOG_LEVEL_FILE=4

#GRAFANA-CONFIG
GF_SECURITY_ADMIN_USER=admin
GF_PLUGINS_PREINSTALL=simpod-json-datasource
GF_SERVER_ROOT_URL=https://deploy.domain.tld:443/grafana

#OTHER
OPSICONFD_RESTORE_BACKUP_URL=
# ^ Restore from a backup of opsi on startup (Leave Empty)
