#paperless-db.container

[Unit]
Description=Paperless Database

[Container]
Image=docker.io/library/postgres:17.10@sha256:0027bef26712baaee437a4ea48fdf3d2d2e2bc5f0d81615374408ca320f3c7e3
ContainerName=paperless-db
Pod=paperless.pod
Volume=/home/paperless/.data/paperless/paperless-db-backups:/var/db-backups:Z
Volume=/home/paperless/.data/paperless/paperless-db:/var/lib/postgresql/data:Z
EnvironmentFile=/srv/CherryTech-App-Configs/podman/8007_paperless/.env
Secret=paperless-db-password,type=env,target=POSTGRES_PASSWORD
HealthCmd=/usr/bin/pg_isready -q -d paperless -U paperless
HealthStartPeriod=5m
HealthInterval=60s
HealthTimeout=15s
HealthRetries=10
Notify=healthy
Memory=2g
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
