#paperless .env

PAPERLESS_URL=https://paperless.apps.example.com

PAPERLESS_TRUSTED_PROXIES=127.0.0.1/32
TZ=America/Detroit

PAPERLESS_ADMIN_USER=system

POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_INITDB_ARGS=--data-checksum

PAPERLESS_REDIS=redis://paperless-redis:6379

PAPERLESS_DBHOST=paperless-db
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless

PAPERLESS_EMPTY_TRASH_DIR=/usr/src/paperless/trash

PAPERLESS_USE_X_FORWARD_HOST=true
PAPERLESS_USE_X_FORWARD_PORT=true
PAPERLESS_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO","https"]

PAPERLESS_ALLAUTH_TRUSTED_PROXY_COUNT=1
