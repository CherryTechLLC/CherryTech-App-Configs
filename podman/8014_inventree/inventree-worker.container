#inventree-worker.container

[Unit]
Description=Inventree Worker
Requires=inventree-redis.service inventree-db.service inventree-server.service
After=inventree-redis.service inventree-db.service inventree-server.service

[Container]
Image=docker.io/inventree/inventree:stable
ContainerName=inventree-worker
Pod=inventree.pod
EnvironmentFile=/home/inventree/.data/inventree/.env
Secret=inventree-db-password,type=env,target=INVENTREE_DB_PASSWORD
Secret=inventree-secret-key,type=env,target=INVENTREE_SECRET_KEY
Secret=inventree-admin-password,type=env,target=INVENTREE_ADMIN_PASSWORD
Volume=/home/inventree/.data/inventree/inventree-data:/home/inventree/data:Z
HealthCmd=invoke worker-health
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
Exec=invoke worker
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
