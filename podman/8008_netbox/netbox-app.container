#netbox-app.container

[Unit]
Description=Netbox App
Requires=netbox-redis.service netbox-redis-cache.service netbox-db.service
After=netbox-redis.service netbox-redis-cache.service netbox-db.service

[Container]
Image=docker.io/netboxcommunity/netbox:v4.7
ContainerName=netbox-app
Network=netbox.network
EnvironmentFile=/home/netbox/.data/netbox/.env
Secret=netbox-db-password,type=mount,target=db_password
Secret=netbox-pepper1-api,type=mount,target=api_token_pepper_1
Secret=netbox-secret-key,type=mount,target=secret_key
Volume=/home/netbox/.data/netbox/.config:/etc/netbox/config:Z
Volume=/home/netbox/.data/netbox/netbox-media:/opt/netbox/netbox/media:Z
Volume=/home/netbox/.data/netbox/netbox-reports:/opt/netbox/netbox/reports:Z
Volume=/home/netbox/.data/netbox/netbox-scripts:/opt/netbox/netbox/scripts:Z
HealthCmd=/opt/netbox/health.sh
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
UserNS=keep-id

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
