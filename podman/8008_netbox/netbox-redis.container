#netbox-redis.container

[Unit]
Description=Netbox Redis

[Container]
Image=docker.io/valkey/valkey:9.1-alpine
ContainerName=netbox-redis
Network=netbox.network
Volume=/home/netbox/.data/netbox/netbox-valkey:/data:Z
EnvironmentFile=/home/netbox/.data/netbox/.env
HealthCmd=/bin/sh -c 'valkey-cli ping | grep PONG'
HealthStartPeriod=30s
HealthInterval=120s
HealthTimeout=15s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=1g
NoNewPrivileges=true
UserNS=keep-id

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
