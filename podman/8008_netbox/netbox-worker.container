#netbox-app.container

[Unit]
Description=Netbox App
Requires=netbox-redis.service netbox-redis-cache.service netbox-db.service
After=netbox-redis.service netbox-redis-cache.service netbox-db.service

[Container]
Image=docker.io/netboxcommunity/netbox:v4.7
ContainerName=netbox-app
Network=netbox.network
EnvironmentFile=/home/netbox/.data/netbox/.env
Secret=netbox-db-password,type=env,target=DB_PASSWORD
Secret=netbox-pepper1-api,type=env,target=API_TOKEN_PEPPER_1
Secret=netbox-secret-key,type=env,target=SECRET_KEY
Volume=/home/netbox/.data/netbox/.config:/etc/netbox/config:Z,ro
Volume=/home/netbox/.data/netbox/netbox-media:/opt/netbox/netbox/media:Z
Volume=/home/netbox/.data/netbox/netbox-reports:/opt/netbox/netbox/reports:Z
Volume=/home/netbox/.data/netbox/netbox-scripts:/opt/netbox/netbox/scripts:Z
HealthCmd=sh -c 'ps -aux | grep -v grep | grep -q rqworker || exit 1'
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true
UserNS=keep-id
Exec=/opt/netbox/venv/bin/python /opt/netbox/netbox/manage.py rqworker
#AddCapability=CAP_NET_BIND_SERVICE    -     Bind to port 80??

[Service]
Restart=always
TimeoutStartSec=900
#ExecStartPre=sleep 30

[Install]
WantedBy=default.target
