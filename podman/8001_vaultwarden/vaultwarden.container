[Unit]
Description=Vaultwarden Container
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/vaultwarden/server:latest
ContainerName=vaultwarden-app
HostName=vaultwarden
Label=io.containers.autoupdate=registry

# Environment
Environment=DOMAIN=${DOMAIN}
Environment=ADMIN_TOKEN=CHANGE-ME
Environment=TZ=${TZ}
Environment=SIGNUPS_ALLOWED=${VAULTWARDEN_SIGNUPS_ALLOWED}

# Env file
EnvironmentFile=/home/vaultwarden/.config/vaultwarden/.env

# Volume
Volume=/home/vaultwarden/.data/vaultwarden/vaultwarden-app:/data:Z

# Port binding (localhost only)
PublishPort=127.0.0.1:8001:80

[Install]
WantedBy=default.target

[Service]
# Restart policy
Restart=always
