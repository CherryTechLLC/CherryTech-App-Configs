#immch-app.container

[Unit]
Requires=immich-redis.service immich-db.service immich-machine-learning.service
After=immich-redis.service immich-db.service immich-machine-learning.service

[Container]
Image=ghcr.io/immich-app/immich-server:latest
ContainerName=immich-app
Pod=immich.pod
EnvironmentFile=/srv/CherryTech-App-Configs/podman/8006_immich/.env
Secret=immich-db-password,type=env,target=POSTGRES_PASSWORD
Secret=immich-redis-password,type=env,target=REDIS_PASSWORD
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/immich/.data/immich/immich-uploads::/data:Z
HealthCmd=/bin/bash immich-healthcheck
HealthStartPeriod=3m
HealthInterval=120s
HealthTimeout=30s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=3g
NoNewPrivileges=true

[Service]
# give some time to the database to start
ExecStartPre=sleep 30
Restart=always

[Install]
WantedBy=default.target
