#immich-machine-learning.container

[Unit]
Description=Immich Machine Learning Container

[Container]
Image=ghcr.io/immich-app/immich-machine-learning:v3
ContainerName=immich-machine-learning
Pod=immich.pod
Volume=/home/immich/.data/immich/immich-model-cache:/cache
HealthCmd=/bin/bash -c 'exec 5<>/dev/tcp/127.0.0.1/3003'
HealthStartPeriod=30s
HealthInterval=120s
HealthTimeout=15s
HealthRetries=10
Notify=healthy
AutoUpdate=registry
Memory=2g

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
