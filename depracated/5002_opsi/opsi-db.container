#opsi-db.container

[Unit]
Description=Opsi Database

[Container]
Image=docker.io/library/mariadb:10.11@sha256:7d829180b5b2a9ba74f6242876ab401a0d7dd338a807e522ef92bc9698760f20
ContainerName=opsi-db
Pod=opsi.pod
Volume=/home/opsi/.data/opsi/opsi-db:/var/lib/mysql:Z
Volume=/home/opsi/.data/opsi/opsi-db-backups:/var/db-backups:Z
EnvironmentFile=/home/opsi/.data/opsi/.env
Secret=opsi-db-password,type=env,target=MYSQL_PASSWORD
Secret=opsi-db-root-password,type=env,target=MYSQL_ROOT_PASSWORD
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthStartPeriod=60s
HealthInterval=60s
HealthTimeout=10s
HealthRetries=15
Notify=healthy
Memory=2g
NoNewPrivileges=true
Exec=--max_connections=1000 --max_allowed_packet=256M --sort_buffer_size=4M

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
